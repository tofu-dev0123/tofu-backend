# =============================================================================
# .env サンプル
# =============================================================================
# このファイルを `.env.local` や `.env.production` 等にコピーし、実際の値を埋めて使う。
#
# ロード対象は環境変数 `ENV_FILE` で切り替え可能 (デフォルト: .env.local):
#   ENV_FILE=.env.production python start.py
#
# 注意:
# - .env.example はリポジトリにコミット OK (実値を入れないこと)
# - .env.local 以外の .env* はコミット禁止 (.gitignore で除外)
# - 本番 (Lightsail VPS) は `.env.production` を box の /srv/app に直置きする
#   (root 600)。Lightsail は IAM ロール非対応のため SSM は使わない。
#   CI のマイグレーション用に DATABASE_URL のみ GitHub Environment secret にも複製する。
# =============================================================================


# ===== 環境 =====
# local      : ローカル開発 (Docker Postgres、LocalStack S3)
# production : 本番 (Lightsail VPS + Neon main branch)
# ※ dev はローカル docker + Cloudflare Tunnel で動かす (専用サーバーは無い)
APP_ENV=local


# ===== Database =====
# local 以外: DATABASE_URL を設定 (Neon の pooler URL を使うこと)
#
# Neon URL 取得: https://console.neon.tech/ → ブランチ → Connection Details → Pooled connection
#
# 形式 (必ず `-pooler` ホスト + sslmode=require):
# DATABASE_URL=postgresql://<user>:<password>@ep-xxxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
#
# 注意:
# - スキーマは `postgres://` でも `postgresql://` でも OK (アプリ側で `postgresql+psycopg://` に正規化)
# - pooler (`-pooler`) ホストを使う (直結 URL は避ける)

# local: 以下 DB_* で Docker Postgres コンテナに接続
DB_HOST=db
DB_PORT=5432
DB_USER=blog_user
DB_PASSWORD=password
DB_NAME=blog_db


# ===== JWT 認証 =====
# SECRET_KEY: 本番は十分な長さのランダム値に置き換えること
#   生成例: openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256


# ===== AWS 認証情報 (S3 画像アップロード用 IAM ユーザー) =====
# local: LocalStack を使うのでダミー値で OK
# 本番: S3 用 IAM ユーザーのアクセスキーを .env.production に直接記載する
#       (Lightsail は IAM ロール非対応のため)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-1


# ===== S3 / CloudFront (画像配信) =====
# local: LocalStack エンドポイントを指定
# 本番: S3_ENDPOINT_URL は空 (AWS 公式エンドポイントを使う)
S3_BUCKET_NAME=tofu-blog-image-local
# S3 バケットのリージョン。未設定だと boto3 が AWS_DEFAULT_REGION に
# フォールバックするため、バケットが別リージョンの場合は必ず指定する。
S3_REGION=ap-northeast-1
S3_ENDPOINT_URL=http://localstack:4566
# 画像配信用 CloudFront ドメイン (本番の据え置きリソース)
CLOUDFRONT_DOMAIN=


# ===== CORS =====
# 許可するオリジンを JSON 配列で指定
# 本番例: ["https://tofubase.com", "https://www.tofubase.com"]
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
