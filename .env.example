# =============================================================================
# .env サンプル
# =============================================================================
# このファイルを `.env.local`, `.env.staging`, `.env.production` 等にコピーし、
# 実際の値を埋めて使用する。
#
# ロード対象は環境変数 `ENV_FILE` で切り替え可能 (デフォルト: .env.local):
#   ENV_FILE=.env.production python start.py
#
# 注意:
# - .env.example はリポジトリにコミット OK (実値を入れないこと)
# - .env.local 以外の .env* はコミット禁止 (.gitignore で除外)
# - 本番用の機密値 (DATABASE_URL, SECRET_KEY 等) は AWS SSM Parameter Store
#   (/blog-platform-backend/<env>/...) に保管。ファイルには直書きせず、
#   起動時に SDK で取得するか、デプロイパイプラインで注入する
# =============================================================================


# ===== 環境 =====
# local      : ローカル開発 (Docker Postgres、LocalStack S3)
# staging    : Railway / 開発用デプロイ環境 (Neon dev branch を参照)
# production : 本番 (AWS Lambda + Neon main branch)
APP_ENV=local


# ===== Database =====
# local 以外: DATABASE_URL を設定 (Neon の pooler URL を使うこと)
#
# Neon URL 取得方法:
#   - SSM から:  aws ssm get-parameter --name "/blog-platform-backend/dev/DATABASE_URL" \
#                 --with-decryption --region us-east-1 --query 'Parameter.Value' --output text
#   - ダッシュボード: https://console.neon.tech/ → ブランチ → Connection Details → Pooled connection
#
# 形式 (必ず `-pooler` ホスト + sslmode=require):
# DATABASE_URL=postgresql://<user>:<password>@ep-xxxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
#
# 注意:
# - スキーマは `postgres://` でも `postgresql://` でも OK (アプリ側で `postgresql+psycopg://` に正規化)
# - Direct connection URL は使わない (Lambda の同時接続でコネクション枯渇)

# local: 以下 DB_* で Docker Postgres コンテナに接続
DB_HOST=db
DB_PORT=5432
DB_USER=blog_user
DB_PASSWORD=password
DB_NAME=blog_db


# ===== JWT 認証 =====
# SECRET_KEY: 本番は十分な長さのランダム値に置き換えること
#   生成例: openssl rand -hex 32
# 本番値は SSM (/blog-platform-backend/<env>/SECRET_KEY) で管理を推奨
SECRET_KEY=change-me
ALGORITHM=HS256


# ===== AWS 認証情報 =====
# local: LocalStack を使うのでダミー値で OK
# Lambda 上: 実行ロール経由で取得されるため未設定で可
# その他のデプロイ環境: IAM ユーザーのアクセスキーを SSM/Parameter Store で管理
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1


# ===== S3 / CloudFront =====
# local: LocalStack エンドポイントを指定
# 本番: S3_ENDPOINT_URL は空 (AWS 公式エンドポイントを使う)
S3_BUCKET_NAME=tofu-blog-image-local
S3_ENDPOINT_URL=http://localstack:4566
CLOUDFRONT_DOMAIN=


# ===== CORS =====
# 許可するオリジンを JSON 配列で指定
# 本番例: ["https://tofubase.com", "https://www.tofubase.com"]
CORS_ALLOW_ORIGINS=["http://localhost:3000"]


# ===== カスタムドメイン (CDK 専用) =====
# 設定すると CDK が CloudFront + ACM 証明書を作成し、このドメインで API を公開する
# 未設定なら Lambda Function URL のみ (生 URL でアクセス)
# 例: dev → dev-api.tofubase.com / prod → api.tofubase.com
CUSTOM_DOMAIN=
