# =============================================================================
# .env サンプル
# =============================================================================
# このファイルを `.env.local`, `.env.staging`, `.env.production` 等にコピーし、
# 実際の値を埋めて使用する。
#
# ロード対象は環境変数 `ENV_FILE` で切り替え可能 (デフォルト: .env.local):
#   ENV_FILE=.env.production python start.py
#
# 注意:
# - .env.example はリポジトリにコミット OK (実値を入れないこと)
# - .env.local 以外の .env* はコミット禁止 (.gitignore で除外)
# =============================================================================


# ===== 環境 =====
# local      : ローカル開発 (Docker Postgres、LocalStack S3)
# staging    : Railway dev / Neon dev branch などの開発デプロイ環境
# production : 本番 (AWS Lambda + Neon main branch)
APP_ENV=local


# ===== Database =====
# staging / production: DATABASE_URL を設定 (Neon の pooler URL を推奨)
# 例:
# DATABASE_URL=postgresql://blog_user:<password>@ep-xxxxx-pooler.us-east-2.aws.neon.tech/blog_db?sslmode=require

# local: DB_* で個別指定 (Docker Postgres コンテナ向け)
DB_HOST=db
DB_PORT=5432
DB_USER=blog_user
DB_PASSWORD=password
DB_NAME=blog_db


# ===== JWT 認証 =====
# SECRET_KEY: 本番は十分な長さのランダム値に置き換えること
#   生成例: openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256


# ===== AWS 認証情報 =====
# local: LocalStack を使うのでダミー値で OK
# production: IAM Role 経由なら未設定でも可
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-1


# ===== S3 / CloudFront =====
# local: LocalStack エンドポイントを指定
# production: S3_ENDPOINT_URL は未設定 (AWS 公式エンドポイントを使う)
S3_BUCKET_NAME=tofu-blog-image-local
S3_ENDPOINT_URL=http://localstack:4566
CLOUDFRONT_DOMAIN=


# ===== CORS =====
# 許可するオリジンを JSON 配列で指定
# 本番例: ["https://tofubase.com", "https://www.tofubase.com"]
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
