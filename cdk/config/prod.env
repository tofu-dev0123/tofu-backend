# prod 環境のデプロイ設定 (非機密のみ・バージョン管理対象)
# 機密値 (DATABASE_URL / SECRET_KEY) は SSM Parameter Store で管理する。
APP_ENV=production
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=tofu-blog-image-prod
CLOUDFRONT_DOMAIN=d2569n9wcnm62h.cloudfront.net
CORS_ALLOW_ORIGINS=["https://tofubase.com", "https://www.tofubase.com"]
CUSTOM_DOMAIN=api.tofubase.com
